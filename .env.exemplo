# Copie para .env.local (fica fora do git) e preencha com a configuração do
# app web do Firebase. Sem estas variáveis, o app roda sem sincronização.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Só para testes locais: aponta o app para o emulador do Firestore.
# VITE_FIRESTORE_EMULADOR=127.0.0.1:8080
